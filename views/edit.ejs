<%- include('header',{title}) %>
<section class="panel"><h2>Редагування запису</h2><% if (typeof error !== 'undefined' && error) { %><p class="form-error" role="alert"><%= error %></p><% } %><form method="post" action="/<%= section %>/<%= section === 'types' ? record.type_id : section === 'equipment' ? record.equipment_id : record.plan_id %>/edit">
<% const definitions = {
  types: [['type_name','Назва типу'],['category','Категорія'],['voltage_class_kv','Клас напруги, кВ','number'],['maintenance_interval_months','Періодичність, міс.','number'],['regulation_document','Регламент'],['purpose_description','Призначення','textarea']],
  equipment: [['type_id','Тип обладнання','types'],['inventory_number','Інвентарний номер'],['equipment_name','Найменування'],['manufacturer','Виробник'],['model','Модель'],['serial_number','Заводський номер'],['commissioned_on','Дата введення','date'],['installation_location','Місце встановлення'],['technical_state','Стан','states'],['note','Примітка','textarea']],
  plans: [['equipment_id','Обладнання','equipment'],['plan_number','Номер плану'],['planned_date','Планова дата','date'],['maintenance_kind','Вид ТО','kinds'],['planned_work','Перелік робіт','textarea'],['priority','Пріоритет','priorities'],['estimated_duration_hours','Тривалість, год','number'],['plan_status','Статус','planStatuses']]
}; %>
<% definitions[section].forEach(([key,label,kind]) => { %><label><%= label %>
<% if (kind === 'types' || kind === 'equipment') { const options = kind === 'types' ? types : equipment; const id = kind === 'types' ? 'type_id' : 'equipment_id'; %>
<select name="<%= key %>" required><% options.forEach(x => { %><option value="<%= x[id] %>" <%= String(record[key])===String(x[id])?'selected':'' %>><%= x.type_name || (x.inventory_number + ' - ' + x.equipment_name) %></option><% }) %></select>
<% } else if (['states','kinds','priorities','planStatuses'].includes(kind)) { %><select name="<%= key %>" required><% locals[kind].forEach(v => { %><option <%= v===record[key]?'selected':'' %>><%= v %></option><% }) %></select>
<% } else if (kind === 'textarea') { %><textarea name="<%= key %>" <%= key==='note'?'':'required' %>><%= record[key] || '' %></textarea>
<% } else { %><input name="<%= key %>" type="<%= kind || 'text' %>" value="<%= record[key] ?? '' %>" <%= key==='voltage_class_kv'||key==='estimated_duration_hours'?'min="0.01" max="9999.99" step="0.01"':key==='maintenance_interval_months'?'min="1" max="65535" step="1"':'' %> required>
<% } %></label><% }) %>
<div class="full form-actions"><button class="action-save" type="submit">Зберегти зміни</button><a class="link-btn action-cancel" href="/<%= section %>">Скасувати</a></div></form></section>
<%- include('footer') %>
