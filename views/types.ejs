<%- include('header',{title}) %>
<section class="panel">
  <h2>
    Типи обладнання
  </h2>
  <p class="small">
    Перша таблиця БД. Перегляд усіх записів та додавання нового типу.
  </p>
  <% if (typeof query !== 'undefined' && query.added) { %>
    <p class="info">
      Новий запис додано.
    </p>
  <% } %>
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th>
            ID
          </th>
          <th>
            Назва
          </th>
          <th>
            Категорія
          </th>
          <th style="text-align: center;">
            кВ
          </th>
          <th style="text-align: center;">
            Період, міс.
          </th>
          <th>
            Регламент
          </th>
          <th>
            Призначення
          </th>
          <th class="action-col" style="text-align: center;">
            Дії
          </th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(x => { %>
          <tr>
            <td>
              <%= x.type_id %>
            </td>
            <td>
              <%= x.type_name %>
            </td>
            <td>
              <%= x.category %>
            </td>
            <td style="text-align: center;">
              <%= x.voltage_class_kv %>
            </td>
            <td style="text-align: center;">
              <%= x.maintenance_interval_months %>
            </td>
            <td>
              <%= x.regulation_document %>
            </td>
            <td>
              <%= x.purpose_description %>
            </td>
            <td class="action-cell">
              <a class="link-btn" href="/types/<%= x.type_id %>/edit">
                Редагувати
              </a>
              <form class="inline-form" method="post" action="/types/<%= x.type_id %>/delete" data-delete-label="Тип обладнання: <%= x.type_name %>">
                <button class="danger" type="submit">
                  Видалити
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<section class="panel">
  <h2>
    Додати тип обладнання
  </h2>
  <form method="post" action="/types">
    <label>
      Назва типу
      <input name="type_name" data-starts-letter="true" minlength="3" maxlength="120" required>
    </label>
    <label>
      Категорія
      <select name="category" required>
        <option value="">
          Оберіть категорію
        </option>
        <% ['Трансформаторне','Комутаційне','Вимірювальне','Захисне','Інше'].forEach(c => { %>
          <option value="<%= c %>">
            <%= c %>
          </option>
        <% }) %>
      </select>
    </label>
    <label>
      Клас напруги, кВ
      <input name="voltage_class_kv" type="number" min="0.01" max="99999.99" step="0.01" required>
    </label>
    <label>
      Періодичність ТО, міс.
      <input name="maintenance_interval_months" type="number" min="1" max="65535" step="1" required>
    </label>
    <label>
      Регламентний документ
      <input name="regulation_document" data-starts-letter="true" minlength="3" maxlength="255" required>
    </label>
    <label class="full">
      Опис призначення
      <textarea name="purpose_description" data-starts-letter="true" minlength="10" maxlength="3000" required>
      </textarea>
    </label>
    <div class="full">
      <button type="submit">
        Додати
      </button>
    </div>
  </form>
</section>
<%- include('footer') %>
