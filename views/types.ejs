<%- include('header',{title}) %>
<section class="panel"><h2>Типи обладнання</h2><p class="small">Перша таблиця БД. Перегляд усіх записів та додавання нового типу.</p><% if (typeof query !== 'undefined' && query.added) { %><p class="info">Новий запис додано.</p><% } %><div class="scroll"><table><thead><tr><th>ID</th><th>Назва</th><th>Категорія</th><th>кВ</th><th>Період, міс.</th><th>Регламент</th><th>Призначення</th></tr></thead><tbody><% rows.forEach(x => { %><tr><td><%= x.type_id %></td><td><%= x.type_name %></td><td><%= x.category %></td><td><%= x.voltage_class_kv %></td><td><%= x.maintenance_interval_months %></td><td><%= x.regulation_document %></td><td><%= x.purpose_description %></td></tr><% }) %></tbody></table></div></section>
<section class="panel"><h2>Додати тип обладнання</h2><form method="post" action="/types"><label>Назва типу<input name="type_name" minlength="3" maxlength="120" required></label><label>Категорія<input name="category" minlength="3" maxlength="120" required></label><label>Клас напруги, кВ<input name="voltage_class_kv" type="number" min="0.01" max="99999.99" step="0.01" required></label><label>Періодичність ТО, міс.<input name="maintenance_interval_months" type="number" min="1" max="65535" step="1" required></label><label>Регламентний документ<input name="regulation_document" minlength="3" maxlength="255" required></label><label class="full">Опис призначення<textarea name="purpose_description" minlength="10" maxlength="3000" required></textarea></label><div class="full"><button type="submit">Додати</button></div></form></section>
<%- include('footer') %>
