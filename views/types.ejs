<%- include('header',{title}) %>
<section class="panel"><h2>Типи обладнання</h2><% if (typeof query !== 'undefined' && query.added) { %><p class="info">Новий запис додано.</p><% } %><div class="scroll"><table><thead><tr><th>ID</th><th>Назва</th><th>Категорія</th><th class="center-col">кВ</th><th class="center-col">Період, міс.</th><th>Регламент</th><th>Призначення</th><th class="actions-header">Дії</th></tr></thead><tbody><% rows.forEach(x => { %><tr><td><%= x.type_id %></td><td><%= x.type_name %></td><td><%= x.category %></td><td class="center-col"><%= x.voltage_class_kv %></td><td class="center-col"><%= x.maintenance_interval_months %></td><td><%= x.regulation_document %></td><td><%= x.purpose_description %></td><td class="table-actions"><div class="action-buttons"><a class="action-link action-edit" href="/types/<%= x.type_id %>/edit">Редагувати</a><form method="post" action="/types/<%= x.type_id %>/delete" onsubmit="return confirm('Видалити тип обладнання: <%= x.type_name.replace(/'/g, "\\'") %>?')"><button class="action-delete" type="submit">Видалити</button></form></div></td></tr><% }) %></tbody></table></div></section>
<section class="panel"><% if (typeof error !== 'undefined' && error) { %><p class="form-error" role="alert"><%= error %></p><% } %><h2>Додати тип обладнання</h2><form method="post" action="/types"><label>Назва типу<input name="type_name" minlength="3" maxlength="120" required></label><label>Категорія<input name="category" minlength="3" maxlength="120" required></label><label>Клас напруги, кВ<input name="voltage_class_kv" type="number" min="0.01" max="99999.99" step="0.01" required></label><label>Періодичність ТО, міс.<input name="maintenance_interval_months" type="number" min="1" max="65535" step="1" required></label><label>Регламентний документ<input name="regulation_document" minlength="3" maxlength="255" required></label><label class="full">Опис призначення<textarea name="purpose_description" minlength="10" maxlength="3000" required></textarea></label><div class="full"><button class="action-save" type="submit">Додати</button></div></form></section>
<% if (typeof values !== 'undefined' && values) { %><script id="previous-values" type="application/json"><%- JSON.stringify(values).replace(/</g, '\\u003c') %></script><% } %>
<%- include('footer') %>
