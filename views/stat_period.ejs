<%- include('header',{title}) %>
<section class="panel">
  <h2>
    Аналіз планового ТО за обраний період
  </h2>
  <form class="stats-form" method="post" action="/statistics/period">
    <label>
      Дата з
      <input type="date" name="from" value="<%=from%>" required>
    </label>
    <label>
      Дата по
      <input type="date" name="to" value="<%=to%>" required>
    </label>
    <div class="full">
      <button>
        Отримати дані
      </button>
    </div>
  </form>
</section>
<% if(rows){ %>
  <section class="panel">
    <p>
      Період:
      <strong>
        <%=from%>
        –
        <%=to%>
      </strong>
      . Сформовано:
      <%=generated%>
      .
    </p>
    <p class="small">
      Прострочені – заплановані роботи з датою раніше поточної; виконується перевірка в межах обраного періоду.
    </p>
    <div class="scroll">
      <table>
        <thead>
          <tr>
            <th>
              Інвентарний №
            </th>
            <th>
              Обладнання
            </th>
            <th>
              Тип
            </th>
            <th>
              Планів у періоді
            </th>
            <th>
              Виконано
            </th>
            <th>
              Прострочено
            </th>
            <th>
              Годин
            </th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(x=>{ %>
            <tr>
              <td>
                <%=x.inventory_number%>
              </td>
              <td>
                <%=x.equipment_name%>
              </td>
              <td>
                <%=x.type_name%>
              </td>
              <td>
                <%=x.plans_count%>
              </td>
              <td>
                <%=x.completed_count%>
              </td>
              <td>
                <%=x.overdue_count%>
              </td>
              <td>
                <%=x.hours_total%>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>
<%- include('footer') %>
