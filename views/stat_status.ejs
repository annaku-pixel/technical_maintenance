<%- include('header',{title}) %>
<section class="panel">
  <h2>
    Статистика планів за типами обладнання
  </h2>
  <p>
    Підсумкові показники на основі трьох пов’язаних таблиць.
  </p>
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th>
            Тип
          </th>
          <th>
            Одиниць обладнання
          </th>
          <th>
            Усього планів
          </th>
          <th>
            Заплановано
          </th>
          <th>
            У роботі
          </th>
          <th>
            Виконано
          </th>
          <th>
            Тривалість, год
          </th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(x=>{ %>
          <tr>
            <td>
              <%= x.type_name %>
            </td>
            <td>
              <%= x.equipment_count %>
            </td>
            <td>
              <%= x.plans_count %>
            </td>
            <td>
              <%= x.scheduled_count %>
            </td>
            <td>
              <%= x.active_count %>
            </td>
            <td>
              <%= x.finished_count %>
            </td>
            <td>
              <%= x.hours_total %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('footer') %>
